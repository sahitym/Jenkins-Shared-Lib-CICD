apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: ${INGRESS_NAME:-myapp-alb-ingress}
  namespace: ${KUBE_NAMESPACE:-staging}
  labels:
    app: ${APP_LABEL:-myapp}
  annotations:
    kubernetes.io/ingress.class: "alb"
    alb.ingress.kubernetes.io/scheme: "${ALB_SCHEME:-internet-facing}"
    alb.ingress.kubernetes.io/target-type: "${ALB_TARGET_TYPE:-ip}"
    # Configure which ports/listeners the ALB should expose. Example below creates both HTTP and HTTPS listeners.
    alb.ingress.kubernetes.io/listen-ports: '[{"HTTP": 80}, {"HTTPS": 443}]'
    # Optional: attach an ACM certificate for HTTPS
    # Replace with a full ARN via envsubst or CI variable
    alb.ingress.kubernetes.io/certificate-arn: "${ALB_CERT_ARN:-arn:aws:acm:REGION:ACCOUNT:certificate/CERT_ID}"
    # Health check config
    alb.ingress.kubernetes.io/healthcheck-path: "${ALB_HEALTHCHECK_PATH:-/health}"
    alb.ingress.kubernetes.io/healthcheck-port: "${ALB_HEALTHCHECK_PORT:-traffic-port}"
    alb.ingress.kubernetes.io/healthcheck-protocol: "${ALB_HEALTHCHECK_PROTOCOL:-HTTP}"
    # Advanced: stickiness, timeouts, IP target group settings
    # alb.ingress.kubernetes.io/target-group-attributes: 'stickiness.enabled=true,stickiness.lb_cookie.duration_seconds=300'

spec:
  ingressClassName: ${INGRESS_CLASS:-alb}
  rules:
    - host: ${HOSTNAME:-example.com}
      http:
        paths:
          - path: /?(.*)
            pathType: ImplementationSpecific
            backend:
              service:
                name: ${SERVICE_NAME:-myapp}
                port:
                  number: ${SERVICE_PORT:-80}
  tls:
    - hosts:
        - ${HOSTNAME:-example.com}
      secretName: ${TLS_SECRET:-myapp-tls}

