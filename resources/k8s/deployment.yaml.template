# resources/k8s/service.yaml.template
apiVersion: v1
kind: Service
metadata:
  name: ${SERVICE_NAME:-myapp}
  namespace: ${KUBE_NAMESPACE:-staging}
  labels:
    app: ${APP_LABEL:-myapp}
spec:
  type: ClusterIP
  selector:
    app: ${APP_LABEL:-myapp}
  ports:
    - name: http
      port: ${SERVICE_PORT:-80}
      targetPort: ${CONTAINER_PORT:-8080}

# If you need a NodePort service instead (for direct node access) uncomment below and comment out the above `type: ClusterIP` block
# spec:
#   type: NodePort
#   ports:
#     - name: http
#       port: ${SERVICE_PORT:-80}
#       targetPort: ${CONTAINER_PORT:-8080}
#       nodePort: ${NODE_PORT:-30080}

---

# resources/k8s/ingress.yaml.template
# This template targets a typical NGINX Ingress Controller. For AWS ALB switch annotations accordingly.
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: ${INGRESS_NAME:-myapp-ingress}
  namespace: ${KUBE_NAMESPACE:-staging}
  labels:
    app: ${APP_LABEL:-myapp}
  annotations:
    # Example annotations for nginx ingress; change or remove if using another controller
    kubernetes.io/ingress.class: "nginx"
    nginx.ingress.kubernetes.io/rewrite-target: "/$1"
    # Uncomment if you want to enable proxy protocol / timeouts etc.
    # nginx.ingress.kubernetes.io/proxy-read-timeout: "300"
    # nginx.ingress.kubernetes.io/proxy-send-timeout: "300"

spec:
  ingressClassName: ${INGRESS_CLASS:-nginx}
  rules:
    - host: ${HOSTNAME:-example.com}
      http:
        paths:
          - path: /(.*)
            pathType: ImplementationSpecific
            backend:
              service:
                name: ${SERVICE_NAME:-myapp}
                port:
                  number: ${SERVICE_PORT:-80}
  # TLS section (optional) - requires a TLS secret in the same namespace
  tls:
    - hosts:
        - ${HOSTNAME:-example.com}
      secretName: ${TLS_SECRET:-myapp-tls}

# ---
# Notes:
# - Replace ${HOSTNAME} and ${TLS_SECRET} via envsubst or CI variables before applying.
# - For AWS ALB Ingress Controller (AWS Load Balancer Controller) use annotations like:
#   alb.ingress.kubernetes.io/scheme: internet-facing
#   alb.ingress.kubernetes.io/target-type: ip
#   alb.ingress.kubernetes.io/listen-ports: '[{"HTTP": 80}, {"HTTPS": 443}]'
#   kubernetes.io/ingress.class: alb
#
# ---
# resources/k8s/ingress-alb.yaml.template
# AWS Load Balancer Controller (ALB) compatible Ingress template. This requires the AWS Load Balancer Controller to be installed in the cluster
# and proper IAM permissions (preferably via IRSA) for the controller. The controller will create an ALB and target groups automatically.
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: ${INGRESS_NAME:-myapp-alb-ingress}
  namespace: ${KUBE_NAMESPACE:-staging}
  labels:
    app: ${APP_LABEL:-myapp}
  annotations:
    kubernetes.io/ingress.class: "alb"
    alb.ingress.kubernetes.io/scheme: "${ALB_SCHEME:-internet-facing}"
    alb.ingress.kubernetes.io/target-type: "${ALB_TARGET_TYPE:-ip}"
    # Configure which ports/listeners the ALB should expose. Example below creates both HTTP and HTTPS listeners.
    alb.ingress.kubernetes.io/listen-ports: '[{"HTTP": 80}, {"HTTPS": 443}]'
    # Optional: attach an ACM certificate for HTTPS
    # Replace with a full ARN via envsubst or CI variable
    alb.ingress.kubernetes.io/certificate-arn: "${ALB_CERT_ARN:-arn:aws:acm:REGION:ACCOUNT:certificate/CERT_ID}"
    # Health check config
    alb.ingress.kubernetes.io/healthcheck-path: "${ALB_HEALTHCHECK_PATH:-/health}"
    alb.ingress.kubernetes.io/healthcheck-port: "${ALB_HEALTHCHECK_PORT:-traffic-port}"
    alb.ingress.kubernetes.io/healthcheck-protocol: "${ALB_HEALTHCHECK_PROTOCOL:-HTTP}"
    # Advanced: stickiness, timeouts, IP target group settings
    # alb.ingress.kubernetes.io/target-group-attributes: 'stickiness.enabled=true,stickiness.lb_cookie.duration_seconds=300'

spec:
  ingressClassName: ${INGRESS_CLASS:-alb}
  rules:
    - host: ${HOSTNAME:-example.com}
      http:
        paths:
          - path: /?(.*)
            pathType: ImplementationSpecific
            backend:
              service:
                name: ${SERVICE_NAME:-myapp}
                port:
                  number: ${SERVICE_PORT:-80}
  tls:
    - hosts:
        - ${HOSTNAME:-example.com}
      secretName: ${TLS_SECRET:-myapp-tls}

